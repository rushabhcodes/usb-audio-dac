{
  "name": "@tsci/rushabhcodes.usb-audio-dac",
  "version": "1.1.1",
  "private": true,
  "description": "Svara USB: PCM2704C USB audio DAC with TPA6132A2 headphone output",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "export:enclosure": "tsci build index.circuit.tsx --disable-parts-engine && bun export-enclosure.mjs"
  },
  "devDependencies": {
    "@jscad/modeling": "2.13.0",
    "@jscad/stl-serializer": "2.1.23",
    "@tscircuit/alphabet": "0.0.25",
    "jscad-planner": "0.0.21",
    "tscircuit": "0.0.3033",
    "typescript": "^5.0.0"
  },
  "author": "rushabhcodes"
}
